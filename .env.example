# Copie para .env.local e preencha com as chaves do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL publica do site (usada nos retornos do checkout e nos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (captcha de login/cadastro) — deixe vazio para desligar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Mercado Pago (checkout + webhook).
# ATENCAO: o Mercado Pago cobra na moeda da conta (tipicamente BRL), enquanto
# a interface exibe USD (lib/format.ts). Alinhe os dois — ou troque o gateway —
# antes de vender para estudantes fora do Brasil. Ver README.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 1 = modo de teste (nao cobra de verdade)
MERCADOPAGO_TEST_MODE=

# Usadas SOMENTE pelo script de seed (scripts/seed-curso.ts), nunca no app:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
